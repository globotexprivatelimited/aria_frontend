"use client";

import { useState } from "react";
import { useRouter } from "next/navigation";
import { signIn, homeForRole } from "../../lib/auth";

const GREEN = "#0F5F4C", GOLD = "#B08A4F", INK = "#1B2621";

export default function LoginPage() {
  const router = useRouter();
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState<string | null>(null);

  async function submit() {
    if (!email || !password) return;
    setBusy(true);
    setError(null);
    const res = await signIn(email.trim(), password);
    setBusy(false);
    if (res.ok && res.role) {
      router.push(homeForRole(res.role));
    } else {
      setError(res.error ?? "Login failed");
    }
  }

  const field = { width: "100%", boxSizing: "border-box" as const, borderRadius: 10, border: "1px solid #E3DECF", background: "#FBFAF5", padding: "13px 15px", fontSize: 15, outline: "none", color: INK };
  const label = { fontSize: 12, textTransform: "uppercase" as const, letterSpacing: ".06em", color: "#9AA09A", fontWeight: 600 as const, marginBottom: 7, display: "block" };

  return (
    <div style={{ display: "flex", minHeight: "100vh", background: "#F6F7F4" }}>
      {/* LEFT: hero image (hidden on mobile) */}
      <div className="login-hero" style={{ flex: "1 1 50%", position: "relative", overflow: "hidden", background: INK }}>
        <img src="/login-hero.jpg" alt="" style={{ position: "absolute", inset: 0, width: "100%", height: "100%", objectFit: "cover" }} />
        <div style={{ position: "absolute", inset: 0, background: "linear-gradient(180deg, rgba(15,38,33,0.15) 0%, rgba(15,38,33,0.55) 100%)" }} />
        <div style={{ position: "absolute", left: 40, bottom: 40, color: "#fff" }}>
          <div style={{ fontSize: 13, textTransform: "uppercase", letterSpacing: ".2em", opacity: 0.85, marginBottom: 8 }}>Aria</div>
          <div style={{ fontFamily: "Georgia, serif", fontSize: 30, fontWeight: 600, lineHeight: 1.2, maxWidth: 380 }}>Your hotel, running itself.</div>
        </div>
      </div>

      {/* RIGHT: login form */}
      <div style={{ flex: "1 1 50%", display: "flex", alignItems: "center", justifyContent: "center", padding: "40px 32px" }}>
        <div style={{ width: "100%", maxWidth: 380 }}>
          <div style={{ marginBottom: 32 }}>
            <div style={{ display: "inline-flex", alignItems: "center", gap: 10, marginBottom: 22 }}>
              <div style={{ width: 42, height: 42, borderRadius: 11, background: GREEN, color: "#fff", display: "flex", alignItems: "center", justifyContent: "center", fontFamily: "Georgia, serif", fontSize: 22, fontWeight: 700 }}>A</div>
              <div>
                <div style={{ fontFamily: "Georgia, serif", fontSize: 19, fontWeight: 700, color: INK, lineHeight: 1 }}>Aria</div>
                <div style={{ fontSize: 11, textTransform: "uppercase", letterSpacing: ".14em", color: GOLD, marginTop: 2 }}>Manager</div>
              </div>
            </div>
            <h1 style={{ fontFamily: "Georgia, serif", fontSize: 27, fontWeight: 700, color: INK, margin: 0 }}>Welcome back</h1>
            <p style={{ fontSize: 14, color: "#6E756F", marginTop: 6 }}>Sign in to your portal</p>
          </div>

          {error ? (
            <div style={{ marginBottom: 18, borderRadius: 10, padding: "11px 14px", fontSize: 13.5, background: "#FBEDE9", color: "#B23A2A", border: "1px solid #EED7D0" }}>{error}</div>
          ) : null}

          <div style={{ marginBottom: 16 }}>
            <label style={label}>Email</label>
            <input value={email} onChange={(e) => setEmail(e.target.value)} onKeyDown={(e) => { if (e.key === "Enter") submit(); }} placeholder="you@hotel.com" style={field} autoFocus />
          </div>
          <div style={{ marginBottom: 24 }}>
            <label style={label}>Password</label>
            <input type="password" value={password} onChange={(e) => setPassword(e.target.value)} onKeyDown={(e) => { if (e.key === "Enter") submit(); }} placeholder="Your password" style={field} />
          </div>

          <button onClick={submit} disabled={busy || !email || !password} style={{ width: "100%", borderRadius: 11, padding: "14px", fontSize: 15, fontWeight: 600, color: "#fff", background: GREEN, border: 0, cursor: busy || !email || !password ? "not-allowed" : "pointer", opacity: busy || !email || !password ? 0.6 : 1 }}>
            {busy ? "Signing in\u2026" : "Sign in"}
          </button>
        </div>
      </div>

      <style>{`
        @media (max-width: 768px) {
          .login-hero { display: none !important; }
        }
      `}</style>
    </div>
  );
}